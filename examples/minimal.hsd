# EVC_DFT Minimal Input File
# This is the minimal input required for a jellium calculation
# All optional parameters use default values

Geometry = {
    # Lattice vectors in Bohr (no unit conversion needed)
    LatticeVectors {
        5.0  0.0  0.0
        0.0  5.0  0.0
        0.0  0.0  5.0
    }
    
    ElectronGas {
        NumElectrons = 2
    }
}

Hamiltonian = DFT {
    XCFunctional = "LDA-PZ"
}

Options = {
    EnergyCutoff [Ha] = 10.0
    FFTGrid = (16, 16, 16)
    SCF {
        MaxIter = 50
        EnergyTolerance = 1e-8
        DensityTolerance = 1e-8
        Mixing = "Linear"
        MixingParameter = 0.5
    }
}

Driver = {
    CalculationType = "Jellium"
}
